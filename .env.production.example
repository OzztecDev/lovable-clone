# Production Environment Variables
# Copy this to .env.production and fill in the values

# Database (Use Supabase, Railway PostgreSQL, or Neon)
DATABASE_URL=postgresql://user:password@host:5432/lovable_clone

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Iyzico Payment (Use sandbox for testing)
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_MERCHANT_ID=your-merchant-id
IYZICO_CALLBACK_URL=https://ai.ozztec.site/api/webhooks/iyzico

# App Configuration
NEXT_PUBLIC_APP_URL=https://ai.ozztec.site
NEXT_PUBLIC_APP_NAME=Lovable Clone
NODE_ENV=production
